BOT_TOKEN=1234567890:replace_with_token_from_BotFather
# Telegram ID через запятую. Эти пользователи смогут управлять любым турниром.
ADMIN_IDS=
DATABASE_PATH=data/table_tennis.sqlite3
MAX_PLAYERS=32
# Публичный HTTPS-адрес Mini App. Для локальной разработки можно оставить пустым.
MINIAPP_URL=
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Разрешает тестовый вход через браузер. На публичном сервере должно быть 0.
WEBAPP_DEV_MODE=0
